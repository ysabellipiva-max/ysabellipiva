const button = document.getElementById('interactiveBtn');
let clicks = 0;

button.addEventListener('click', () => {
  clicks++;
  if (clicks === 1) {
    button.innerText = 'Incrível! Clique de novo 🔥';
    button.style.backgroundColor = '#10b981'; // Altera a cor para verde
    button.style.boxShadow = '0 4px 20px rgba(16, 185, 129, 0.4)';
  } else {
    button.innerText = `Você interagiu ${clicks} vezes! ✨`;
  }
});
